{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ramifica",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=5000"
      ]
    },
    {
      // Local app (:5000) + emulated Functions (local code); real Auth,
      // Firestore, and Storage so login and drafts persist.
      // ASR_RELAY_URL points dictation at the local relay (accepts real
      // tokens via Google certs as well as emulator ones).
      "name": "Ramifica (emulators)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=EMULATOR=true",
        "--dart-define=ASR_RELAY_URL=ws://localhost:8081"
      ],
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=5000"
      ],
      "preLaunchTask": "emulators-and-relay"
    }
  ]
}
