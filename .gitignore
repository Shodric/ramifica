# Firebase build and deployment files
/firebase-debug.log
/firebase-debug.*.log

# Firebase Hosting cache
*.cache
hosting/.cache

# Firebase Functions
**/node_modules/
**/**/node_modules/
/functions/.runtimeconfig.json

# Secrets. firebase.json, .firebaserc, rules, and cors.json stay in git.
# The Firebase web apiKey is public. These files are not.
**/*firebase-adminsdk*.json
**/serviceAccount*.json
**/*service-account*.json
**/*appcheck-debug-token*
**/*app-check-debug-token*

# Environment files (local configs)
.env
.env.*
**/.env
**/.env.*
.secret.local
.secret.*
**/.secret.local
**/.secret.*
!.env.example
!**/.env.example
!.secret.local.example
!**/.secret.local.example

# Firebase Emulators
/firebase-*.zip
/.firebase/
/emulator-ui/

