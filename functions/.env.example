# Copy to .env.local for the Functions emulator, or .env.<project-id>
# for deployment. Keep API keys in .secret.local / Secret Manager.
# See ../docs/ai-configuration.md. Values below preserve existing models.

# Text (S0/S1/P4), image generation, and unary transcription: Meta API.
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3-contributor
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Optional full endpoint overrides; otherwise resolved from META_BASE_URL.
# META_CHAT_URL=https://api.meta.ai/v1/chat/completions
# META_IMAGES_URL=https://api.meta.ai/v1/images/generations
# META_TRANSCRIBE_URL=https://api.meta.ai/v1/asr/transcribe

# Images: auto (Meta key first, ComfyUI otherwise), meta, or comfy.
AI_IMAGE_PROVIDER=auto
# Set comfy explicitly to use it even when a Meta key is present.
COMFYUI_URL=
COMFYUI_CKPT=v1-5-pruned-emaonly.safetensors
COMFYUI_STEPS=20
COMFYUI_CFG=7
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=normal

# TTS and video use the OpenRouter-compatible adapters.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Kore
OPENROUTER_TTS_INSTRUCTIONS="Off-screen narrator, one take. Do not add, translate, or repeat words. Speak naturally in the language of the supplied text."
# The selected TTS model must return signed 16-bit little-endian mono PCM.
# This is the rate of the returned bytes, not an API resampling request.
TTS_PCM_SAMPLE_RATE=24000
OPENROUTER_VIDEO_MODEL=heygen/heygen-video-1
OPENROUTER_VIDEO_RESOLUTION=480p
OPENROUTER_VIDEO_ASPECT_RATIO=9:16
OPENROUTER_VIDEO_DURATION_SECONDS=10
# HeyGen uses the first frame. Enable only with a model supporting both ends.
OPENROUTER_VIDEO_USE_END_FRAME=false
# Optional full endpoint overrides. Video POST/poll/content share this root.
# OPENROUTER_SPEECH_URL=https://openrouter.ai/api/v1/audio/speech
# OPENROUTER_VIDEOS_URL=https://openrouter.ai/api/v1/videos
