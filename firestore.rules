rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && (
        resource.data.status == "published"
        || request.auth.uid == resource.data.authorId
      );
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == "draft";
      allow update: if signedIn()
        && request.auth.uid == resource.data.authorId
        && resource.data.status == "draft"
        && request.resource.data.status == "draft"
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if signedIn()
        && request.auth.uid == resource.data.authorId
        && resource.data.status == "draft";

      // Only the author reads nodes directly (Create).
      // Players use loadPlayback and graphStubs.
      match /nodes/{nodeId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "handle", "photoUrl", "locale", "providers", "createdAt"]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["displayName", "handle", "photoUrl", "locale"]);
    }

    match /follows/{uid}/authors/{authorId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/{document=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /sagas/{sagaId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn() && resource.data.active == true;
      allow write: if false;
    }
  }
}
