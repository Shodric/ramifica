rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Story media is written by Functions. Clients read token URLs, not the SDK.
    match /stories/{storyId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Creator upload. onUploadFinalized re-encodes it to H.264 MP4.
    match /uploads/{uid}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|quicktime)');
      allow read, update, delete: if false;
    }
  }
}
