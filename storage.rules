rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Story media is written by Functions. Clients read token URLs, not the SDK.
    match /stories/{storyId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Creator upload. onUploadFinalized re-encodes it to H.264 MP4.
    match /uploads/{uid}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|quicktime)');
      allow read, update, delete: if false;
    }

    // Scene reference stills, cropped 9:16 client-side. Outside uploads/
    // so onUploadFinalized ignores them; nothing server-side runs here.
    // The owner mints the token download URL (needs `get`) and reads the
    // still back through it; listing stays closed.
    match /references/{uid}/{fileName} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, update, delete: if false;
    }
  }
}
